# ── Ports ───────────────────────────────────────────────────────────────────
API_PORT=3000

# ── Services ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
PYTHON_URL=http://localhost:8000
API_URL=http://localhost:3000

# ── External tools ───────────────────────────────────────────────────────────
# Leave blank to use system PATH (recommended if tools are installed globally).
# Set to full path if you need to point to a specific binary.
FFMPEG_PATH=ffmpeg
YT_DLP_PATH=yt-dlp
# FFMPEG_BIN is the directory passed to yt-dlp --ffmpeg-location (optional)
FFMPEG_BIN=
